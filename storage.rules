rules_version = '2';

// Paths/shapes derived from the real upload code in app/lib/providers/
// auth_provider.dart (uploadAvatar) and app/lib/screens/clubs/
// club_detail_screen.dart (_pickClubImage) — see issue #19.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Mirrors the retired backend's ALLOWED_*_TYPES / MAX_*_BYTES (JPEG,
    // PNG, WEBP, GIF; 5MB) — client-side validation in image_validation.dart
    // fails fast, this is the actual enforcement boundary.
    function isValidImage() {
      return request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isOwnerOrAdmin(clubId) {
      let membershipPath = /databases/(default)/documents/clubs/$(clubId)/memberships/$(request.auth.uid);
      // Guard existence first — a non-member has no membership doc at all,
      // and get()'ing a missing doc throws rather than just failing the
      // subsequent field check.
      return firestore.exists(membershipPath) && firestore.get(membershipPath).data.role in ['owner', 'admin'];
    }

    match /avatars/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && uid == request.auth.uid && isValidImage();
    }

    match /clubImages/{clubId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidImage() && isOwnerOrAdmin(clubId);
    }
  }
}
